{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DATABASE_PATH": "../Ophi.Api/data/ophi.db",
  "Alerts": {
    "CooldownMinutes": 60,
    "MaxAlertsPerUser": 100
  },
  "Worker": {
    "DispatchIntervalSeconds": 60,
    "BatchSize": 50,
    "MaxFailuresBeforeError": 3,
    "MaxSuspiciousBeforePause": 3,
    "PriceAnomalyThreshold": 0.7
  }
}