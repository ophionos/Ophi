# Database — PostgreSQL (SQLite is test-only). The Docker compose files set these for you and only
# need POSTGRES_PASSWORD; set them explicitly when running the API outside compose.
DB_PROVIDER=postgres
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=ophi;Username=ophi;Password=ophi
# Used by the bundled `db` container in docker compose:
POSTGRES_PASSWORD=ophi

# Application URL (frontend URL for CORS + links in alert emails).
# Off localhost, set this to the URL you actually reach the app at.
APP_URL=http://localhost:3000

# Public origin of the SvelteKit web container (multi-container docker-compose.yml only).
# Should match the URL you load in the browser so adapter-node builds correct absolute URLs and
# its CSRF origin check passes. Usually identical to APP_URL.
ORIGIN=http://localhost:3000

# Bearer token for the Prometheus /metrics endpoint. Optional: in Production the
# endpoint is disabled while this is empty. Generate one with e.g. `openssl rand -hex 32`.
MetricsToken=

# Email Configuration (optional - for alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@ophi.app
SMTP_PASS=your-smtp-password
SMTP_FROM=Ophi <notifications@ophi.app>

# Telegram / Pushover (optional) — one operator bot / app; each user saves only their chat id / user key.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PUSHOVER_APP_TOKEN=
