{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DATABASE_PATH": "./data/ophi.db",
  "APP_URL": "http://localhost:5173",
  "Alerts": {
    "CooldownMinutes": 60,
    "MaxAlertsPerUser": 100
  },
  "Registration": {
    "Enabled": true
  },
  "MetricsToken": "",
  "Worker": {
    "MaxFailuresBeforeError": 3,
    "ScrapeLogRetentionDays": 30,
    "ReadNotificationRetentionDays": 90,
    "MaxSuspiciousBeforePause": 3,
    "PriceAnomalyThreshold": 0.7
  }
}
