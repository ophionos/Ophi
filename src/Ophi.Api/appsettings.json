{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DATABASE_PATH": "./data/ophi.db",
  "APP_URL": "http://localhost:5173",
  "Scraping": {
    "DefaultIntervalMinutes": 60,
    "MinIntervalMinutes": 15,
    "MaxRetries": 3,
    "TimeoutSeconds": 30
  },
  "Alerts": {
    "CooldownMinutes": 60,
    "MaxAlertsPerUser": 100
  },
  "Registration": {
    "Enabled": true
  },
  "DataRetention": {
    "PriceHistoryDays": 365
  },
  "MetricsToken": "",
  "Worker": {
    "MaxFailuresBeforeError": 3,
    "ScrapeLogRetentionDays": 30,
    "ReadNotificationRetentionDays": 90,
    "MaxSuspiciousBeforePause": 3,
    "PriceAnomalyThreshold": 0.7
  }
}
