#!/bin/sh
# Blocks a push whose new commits add lines, or carry messages, that match a pattern in
# .githooks/leak-patterns.local — an untracked file, one case-insensitive extended regex per line
# (# comments and blank lines ignored). No patterns file, no check. Enable once per clone with
#   git config core.hooksPath .githooks
# A deliberate match can be pushed with --no-verify after review.

root=$(git rev-parse --show-toplevel)
patterns_file="$root/.githooks/leak-patterns.local"
[ -f "$patterns_file" ] || exit 0

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
tr -d '\r' < "$patterns_file" | grep -v -E '^[[:space:]]*(#|$)' > "$patterns"
[ -s "$patterns" ] || exit 0

zero=0000000000000000000000000000000000000000
found=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	if [ "$remote_sha" = "$zero" ]; then
		range="$local_sha --not --remotes" # new branch: commits on no remote yet
	else
		range="$remote_sha..$local_sha"
	fi
	# shellcheck disable=SC2086 # $range is deliberately split into rev arguments
	hits=$(
		{
			git log -p --no-color --format= $range | grep -a '^+' | grep -a -v '^+++ '
			git log --format=%B $range
		} | grep -a -n -i -E -f "$patterns"
	)
	if [ -n "$hits" ]; then
		found=1
		echo "pre-push: $remote_ref — new content matches .githooks/leak-patterns.local:" >&2
		echo "$hits" | cut -c1-200 >&2
	fi
done

if [ "$found" -ne 0 ]; then
	echo "pre-push: push blocked. The repo is public. Remove the match, or push with --no-verify if it is intended." >&2
	exit 1
fi
exit 0
