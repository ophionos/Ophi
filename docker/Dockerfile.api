# Build stage
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

# Copy build-config files. Directory.Packages.props (Central Package Management) and
# Directory.Build.props (shared TargetFramework et al.) are needed at restore; .editorconfig
# tunes the analyzers and must be present at build time under TreatWarningsAsErrors. global.json
# only selects the test runner today, but it is the file an SDK pin would live in — copying it
# keeps the container on the same SDK the repo builds with.
COPY Directory.Packages.props Directory.Build.props global.json .editorconfig ./
COPY src/Ophi.Domain/*.csproj Ophi.Domain/
COPY src/Ophi.Infrastructure/*.csproj Ophi.Infrastructure/
COPY src/Ophi.Worker/*.csproj Ophi.Worker/
COPY src/Ophi.Api/*.csproj Ophi.Api/

# Restore dependencies
RUN dotnet restore Ophi.Api/Ophi.Api.csproj -a $TARGETARCH

# Copy source code
COPY src/Ophi.Domain/ Ophi.Domain/
COPY src/Ophi.Infrastructure/ Ophi.Infrastructure/
COPY src/Ophi.Worker/ Ophi.Worker/
COPY src/Ophi.Api/ Ophi.Api/

# Build and publish
RUN dotnet publish Ophi.Api/Ophi.Api.csproj -c Release -o /app/publish -a $TARGETARCH --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG TARGETARCH
# Opt-in Chromium for interactive anti-bot challenge solving (compose sets it from CHALLENGE_SOLVING).
# Off by default: it adds a few hundred MB, and the API needs no browser otherwise.
ARG INSTALL_CHROMIUM=false
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Same install as docker/Dockerfile.worker (see the notes there). Only the Playwright driver is copied
# first, so a code change does not repeat the browser download.
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
COPY --from=build /app/publish/.playwright ./.playwright
RUN if [ "$INSTALL_CHROMIUM" = "true" ]; then \
      case "$TARGETARCH" in \
        amd64) PW_NODE_DIR=linux-x64 ;; \
        arm64) PW_NODE_DIR=linux-arm64 ;; \
        *) echo "Unsupported TARGETARCH '$TARGETARCH' for the Playwright driver" >&2; exit 1 ;; \
      esac && \
      PW_NODE="/app/.playwright/node/$PW_NODE_DIR/node" && \
      chmod +x "$PW_NODE" && \
      NODE_OPTIONS=--dns-result-order=ipv4first \
      "$PW_NODE" /app/.playwright/package/cli.js install --with-deps chromium && \
      chown -R app:app /app/.playwright /app/.playwright-browsers; \
    fi

# Create data directory and set permissions for built-in non-root user
RUN mkdir -p /app/data && \
    chown -R app:app /app/data

USER app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:5000
ENV DATABASE_PATH=/app/data/ophi.db

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

ENTRYPOINT ["dotnet", "Ophi.Api.dll"]
