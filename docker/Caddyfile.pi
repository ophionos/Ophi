# Example Caddyfile for Raspberry Pi deployment.
# Caddy runs on the host (not in Docker) and handles:
#   1. HTTPS termination (automatic Let's Encrypt)
#   2. Serving the SvelteKit static files
#   3. Reverse proxying /api/* and /health to the .NET container
#
# Static files are NOT in a Docker volume — they're baked into the image at /app/static and
# extracted once to a host directory at deploy time (see the docker-compose.pi.yml header for the
# exact `docker cp` / `docker compose run` command; e.g. they land in ~/ophi/static).
#
# Copy this to /etc/caddy/Caddyfile (or wherever your Caddy config lives) and adjust:
#   - Replace "ophi.example.com" with your domain (or use :80 for local/LAN)
#   - Set `root` below to the host directory you extracted the static files into

ophi.example.com {
	# Serve static SvelteKit files (host directory you extracted /app/static into)
	root * /home/pi/ophi/static
	file_server

	# Proxy API requests to the .NET container
	handle /api/* {
		reverse_proxy localhost:5000
	}

	# Proxy health endpoint
	handle /health {
		reverse_proxy localhost:5000
	}

	# Proxy OpenAPI spec
	handle /openapi/* {
		reverse_proxy localhost:5000
	}

	# SPA fallback — serve index.html for unmatched routes
	try_files {path} /index.html

	# Compression
	encode gzip zstd

	# Security headers (Caddy adds HSTS automatically with HTTPS)
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
